<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/relativeProfileImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="32dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/android_sample_image"
                    app:shapeAppearanceOverlay="@style/CircularImageView" />

                <ProgressBar
                    android:id="@+id/progressBarImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/networks_container"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="42dp"
                android:layout_below="@+id/relativeProfileImage"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/llLinkedin"
                    android:layout_width="@dimen/social_buttons_landscape"
                    android:layout_height="wrap_content"
                    android:background="@drawable/social_button_background"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_linkedin"
                        app:tint="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPhone"
                    android:layout_width="@dimen/social_buttons_landscape"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="80dp"
                    android:background="@drawable/social_button_background"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_whatsapp"
                        app:tint="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llGithub"
                    android:layout_width="@dimen/social_buttons_landscape"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/llLinkedin"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/social_button_background"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_github"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/TextViewPrimaryColor"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llgmail"
                    android:layout_width="@dimen/social_buttons_landscape"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/llPhone"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/social_button_background"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_mail"
                        app:tint="@color/primary" />
                </LinearLayout>

            </RelativeLayout>
        </RelativeLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <include
                layout="@layout/view_theme_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:id="@+id/title_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    style="@style/TextViewPrimaryColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Title" />

                <TextView
                    android:id="@+id/tvUserHeadLine"
                    style="@style/TextViewPrimaryColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="24dp"
                    android:text="@string/subtitle_main_screen"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/button1"
                    style="@style/ButtonsBorder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="Hide" />

                <Button
                    android:id="@+id/button2"
                    style="@style/ButtonsBorder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Button 2" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGoToExperience"
                style="@style/ButtonsBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="42dp"
                android:layout_marginTop="40dp"
                android:text="@string/go_to_experiences" />

            <Button
                android:id="@+id/btnGoToCertificates"
                style="@style/ButtonsBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="42dp"
                android:layout_marginTop="10dp"
                android:text="@string/go_to_certificates" />

            <Button
                android:id="@+id/btnGoToAbout"
                style="@style/ButtonsBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="42dp"
                android:layout_marginTop="10dp"
                android:text="@string/go_to_about"  />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
